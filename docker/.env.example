# ==============================================
# 环境配置文件模板
# 使用方式: 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# 修改 .env 后需重启:
#   docker compose down && docker compose up -d
# ==============================================

# MySQL
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=knowledge_qa_system
MYSQL_USER=qa_app
MYSQL_PASSWORD=change-this-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Neo4j
NEO4J_AUTH=neo4j/change-this-neo4j-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# DeepSeek LLM (必须填写)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
EMBEDDING_MODEL=deepseek-embedding

# JWT (生产环境务必修改)
JWT_SECRET_KEY=generate-a-random-secret-key-and-replace-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
DATABASE_URL=mysql+pymysql://qa_app:change-this-db-password@mysql:3306/knowledge_qa_system
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
UPLOAD_DIR=/app/uploads
